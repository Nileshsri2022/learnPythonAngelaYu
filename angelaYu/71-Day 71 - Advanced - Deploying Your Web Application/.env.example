# Copy this file to .env and fill in real values.
# .env itself must stay in .gitignore - it holds secrets.
#
# Read them in Python with:
#     import os
#     app.config["SECRET_KEY"] = os.environ.get("FLASK_KEY")

# A long random string - generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_KEY=

# Production: the DATABASE_URL your hosting provider gives you
# Local: leave unset to fall back to SQLite (sqlite:///posts.db)
DATABASE_URL=

# Email (used by the blog's contact form / alerts)
MY_EMAIL=
MY_EMAIL_PASSWORD=
